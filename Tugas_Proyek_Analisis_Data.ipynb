        "# Visualisasi hasil binning kecepatan angin\n",
        "plt.figure(figsize=(8,5))\n",
        "sns.barplot(\n",
        "    data=wind_bin_analysis,\n",
        "    x='windspeed_bin',\n",
        "    y='cnt'\n",
        ")\n",
        "plt.title('Rata-rata Penyewaan Sepeda Berdasarkan Kategori Kecepatan Angin')\n",
        "plt.xlabel('Kategori Kecepatan Angin')\n",
