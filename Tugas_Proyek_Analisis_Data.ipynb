      "source": [
        "visualisasi dampak Kelembapan pada pengendara kasual vs pengendara terdaftar"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# 2. Binning Kelembapan\n",
        "df_hour['hum_bin'] = pd.cut(\n",
        "    df_hour['hum'],\n",
        "    bins=3,\n",
        "    labels=['Rendah', 'Sedang', 'Tinggi']\n",
        ")\n",
        "\n",
        "hum_bin_analysis = df_hour.groupby('hum_bin', observed=False)['cnt'].mean().reset_index()\n",
        "\n",
        "# Visualisasi hasil binning kelembapan\n",
        "plt.figure(figsize=(8,5))\n",
        "sns.barplot(\n",
        "    data=hum_bin_analysis,\n",
        "    x='hum_bin',\n",
        "    y='cnt'\n",
        ")\n",
        "plt.title('Rata-rata Penyewaan Sepeda Berdasarkan Kategori Kelembapan')\n",
        "plt.xlabel('Kategori Kelembapan')\n",
        "plt.ylabel('Rata-rata Penyewaan')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
